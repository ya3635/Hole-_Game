    m_Modifications:
    - target: {fileID: 114862740261869284, guid: f43c82fa79085354ba883fd6d09728bc,
        type: 3}
      propertyPath: m_Text
      value: 'This shows you what happens when you paint a mesh that isn''t suitable
        for painting. For a mesh to be paintable, it shouldn''t have overlapping
        UV, or UV areas that exceed the 0..1 range (e.g. tiling). Notice the paint
        appears in unexpected areas on this mesh, because it contains both tiling
        UV, and overlapping areas.

        Swipe / Click + Drag = Paint'
      objectReference: {fileID: 0}
